{
  "version": 2,
  "builds": [
    {
      "src": "frontend/dev-server/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "env": {
    "NITRO_PRESET": "vercel"
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
