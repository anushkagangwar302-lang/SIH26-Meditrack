# Frontend environment variables.
# Only VITE_-prefixed variables are exposed to the browser bundle.

# Base URL of MediKiosk-Backend.
# For production: Set to your deployed backend URL (e.g., https://api.yourdomain.com)
# For development: Use http://localhost:8000
# Leave empty to use same-origin /api/v1 (useful when frontend and backend are on same domain)
VITE_API_BASE_URL=

# Nitro build target. Vercel/Netlify/Cloudflare set this automatically via their
# platform config; override locally to test a specific output.
# NITRO_PRESET=node
