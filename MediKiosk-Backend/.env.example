# MediKiosk-Backend Environment Configuration
# Copy this file to .env and replace all CHANGE_ME values before running
# SECRETS should never be committed to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string for async SQLAlchemy
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://medikiosk:CHANGE_ME@localhost:5432/medikiosk

# PostgreSQL password (for docker-compose compatibility)
# SECRET - Must be strong and unique per deployment
POSTGRES_PASSWORD=CHANGE_ME

# DB connection pool settings (adjust based on replica count and Postgres max_connections)
# Environment-specific: Increase replicas requires decreasing pool_size per replica
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis host (use 'redis' in docker-compose, localhost for local dev)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no auth (not recommended for production)

# Redis databases (separate for different uses to avoid key collisions)
# Environment-specific: Use different DB numbers in production
REDIS_DB_SESSION=0        # Session/interview state with TTL
REDIS_DB_LOCKS=1         # Distributed locks
REDIS_DB_RATELIMIT=2     # Rate limiting counters
REDIS_DB_CACHE=3         # General caching
REDIS_DB_CELERY_BROKER=4 # Celery task queue
REDIS_DB_CELERY_RESULT=5 # Celery task results

# Redis connection pool
REDIS_POOL_SIZE=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# SECURITY & ENCRYPTION (DPDP Act 2023 Compliance)
# =============================================================================
# JWT secret key for access tokens (minimum 32 characters recommended)
# SECRET - Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME

# JWT secret key for refresh tokens (should be different from access token secret)
# SECRET - Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_REFRESH_SECRET_KEY=CHANGE_ME

# JWT token expiration times (in minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Field-level encryption key for Aadhaar/ABHA data (32 bytes, base64 encoded)
# SECRET - Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME

# HMAC key for webhook signature verification (32 bytes, base64 encoded)
# SECRET - Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WEBHOOK_HMAC_KEY=CHANGE_ME

# Password hashing algorithm (argon2id recommended)
PASSWORD_HASH_ALGORITHM=argon2id

# =============================================================================
# ABDM / ABHA INTEGRATION
# =============================================================================
# ABDM HIE-CM (Health Information Exchange - Consent Manager) API base URL
# Environment-specific: Use sandbox URL for development, production URL for live
ABDM_HIE_CM_BASE_URL=https://dev.abdm.gov.in/hie-cm

# ABDM client ID (registered with ABDM)
# SECRET - Register at https://abdm.gov.in/
ABDM_CLIENT_ID=CHANGE_ME

# ABDM client secret (registered with ABDM)
# SECRET - Register at https://abdm.gov.in/
ABDM_CLIENT_SECRET=CHANGE_ME

# ABDM callback URL for webhooks (must be publicly accessible)
# Environment-specific: Set to your production domain
ABDM_CALLBACK_URL=https://your-domain.com/api/v1/abdm/webhooks

# Development mode ABHA OTP (bypasses real ABHA OTP verification)
# WARNING: Must be empty or removed in production
DEV_ABHA_OTP=246810

# =============================================================================
# BHASHINI / AI4BHARAT INTEGRATION
# =============================================================================
# Bhashini API base URL
# Environment-specific: Use sandbox for development
BHASHINI_API_URL=https://api.bhashini.gov.in

# Bhashini API key (obtain from https://bhashini.gov.in/)
# SECRET - Register at https://bhashini.gov.in/
BHASHINI_API_KEY=CHANGE_ME

# Bhashini user ID (obtain from https://bhashini.gov.in/)
# SECRET - Register at https://bhashini.gov.in/
BHASHINI_USER_ID=CHANGE_ME

# Bhashini pipeline IDs (specific to language/task)
# Environment-specific: Configure based on supported languages
BHASHINI_ASR_PIPELINE_ID=CHANGE_ME
BHASHINI_TTS_PIPELINE_ID=CHANGE_ME

# Fallback languages when Bhashini is unavailable
BHASHINI_FALLBACK_LANGUAGE=en

# =============================================================================
# OCR / VISION SERVICE
# =============================================================================
# OCR service provider (tesseract, google_vision, aws_textract, azure_form_recognizer)
OCR_SERVICE_PROVIDER=tesseract

# API key for cloud OCR services (if using cloud provider)
# SECRET - Only required for cloud providers
OCR_API_KEY=CHANGE_ME

# OCR service endpoint (if using custom/self-hosted OCR)
# Environment-specific: Set to your OCR service URL
OCR_SERVICE_URL=http://localhost:8080

# OCR timeout in seconds
OCR_TIMEOUT=30

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
# Celery broker URL (Redis)
CELERY_BROKER_URL=redis://localhost:6379/4

# Celery result backend (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/5

# Celery task serialization
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# Celery timezone
CELERY_TIMEZONE=Asia/Kolkata

# Celery task timeout (in seconds)
CELERY_TASK_TIMEOUT=300

# Celery task soft timeout (in seconds)
CELERY_TASK_SOFT_TIMEOUT=240

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limit for general API endpoints (requests per second per IP)
RATE_LIMIT_GENERAL=10

# Rate limit for authentication endpoints (requests per second per IP)
RATE_LIMIT_AUTH=5

# Rate limit for document upload endpoints (requests per minute per IP)
RATE_LIMIT_UPLOAD=10

# Rate limit for WebSocket connections (connections per minute per IP)
RATE_LIMIT_WEBSOCKET=5

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=50

# Allowed file types for document uploads
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# Temporary scan file retention period (in hours)
TEMP_SCAN_RETENTION_HOURS=24

# Encrypted vault retention period (in days)
ENCRYPTED_VAULT_RETENTION_DAYS=365

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Environment-specific: Use INFO in production, DEBUG in development
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# Request ID header name for distributed tracing
REQUEST_ID_HEADER=X-Request-ID

# Audit log file path (separate from application logs for compliance)
AUDIT_LOG_PATH=/var/log/medikiosk/audit.log

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application environment (development, staging, production)
# Environment-specific: Set appropriately per deployment
APP_ENV=development

# Application name (for logging and metrics)
APP_NAME=MediKiosk-Backend

# Application version (for deployment tracking)
APP_VERSION=1.0.0

# CORS allowed origins (comma-separated)
# For production: Set to your deployed frontend domain (e.g., https://yourdomain.com)
# For development: http://localhost:3000,http://localhost:8000
# Leave empty to allow all origins (NOT recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Trusted proxy count (if behind reverse proxy)
TRUSTED_PROXY_COUNT=1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable AYUSH clinical intake
FEATURE_AYUSH_ENABLED=true

# Enable/disable SOCRATES dialogue branching
FEATURE_SOCRATES_ENABLED=true

# Enable/disable ABDM integration (set to false if ABDM not available)
FEATURE_ABDM_ENABLED=true

# Enable/disable Bhashini voice interface
FEATURE_VOICE_ENABLED=true

# Enable/disable OCR document processing
FEATURE_OCR_ENABLED=true

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
# Enable Prometheus metrics endpoint
METRICS_ENABLED=true

# Metrics endpoint path
METRICS_PATH=/metrics

# Health check interval (in seconds)
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# DEVELOPMENT ONLY SETTINGS
# =============================================================================
# Enable debug mode (NEVER set to true in production)
DEBUG=false

# Enable auto-reload (for development only)
AUTO_RELOAD=false

# Mock external services (for development/testing)
MOCK_EXTERNAL_SERVICES=false

# Skip SSL verification (for development only - NEVER in production)
SKIP_SSL_VERIFICATION=false
