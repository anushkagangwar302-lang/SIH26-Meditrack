# =============================================================================
# MediKiosk-Backend environment
# Copy to .env and fill values. Items marked SECRET must never be committed.
# Every variable is environment-specific and MUST be set per deployment.
# =============================================================================

# --- App ---
APP_NAME=MediKiosk-Backend
APP_ENV=development
# production | staging | development — controls fail-loud vs degrade (external APIs)
DEBUG=false
# SECRET: used only to detect misconfiguration; never enable DEBUG in production
LOG_LEVEL=INFO
# json logs always in production; pretty console only if APP_ENV=development
API_V1_PREFIX=/api/v1

# Bind address for uvicorn (compose overrides)
HOST=0.0.0.0
PORT=8000

# --- Postgres (SECRET: password) ---
# Connection string for async SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://medikiosk:CHANGE_ME@postgres:5432/medikiosk
# Pool sizing MUST be computed against replica count × Postgres max_connections.
# Formula: api_replicas*(DB_POOL_SIZE+DB_MAX_OVERFLOW) + celery_concurrency <= max_connections - 10
# Example (max_connections=100, 4 API replicas, 2 workers): 4*(8+4) + 16 = 64
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Redis ---
# Single Redis in docker-compose. Logical DBs isolate concerns on one instance.
# If you move to Redis Cluster, ALL urls MUST use DB 0 and rely on key prefixes
# (Cluster does not support multiple logical databases).
REDIS_HOST=redis
REDIS_PORT=6379
# SECRET if Redis AUTH is enabled in production
REDIS_PASSWORD=
REDIS_DB_SESSION=0
REDIS_DB_CELERY_BROKER=1
REDIS_DB_CELERY_RESULT=2
REDIS_DB_LOCKS=3
REDIS_DB_RATELIMIT=4
# Key prefixes (used even when DBs differ — required for Cluster later)
REDIS_PREFIX_SESSION=medikiosk:session:
REDIS_PREFIX_INTERVIEW=medikiosk:interview:
REDIS_PREFIX_WS=medikiosk:ws:
REDIS_PREFIX_LOCK=medikiosk:lock:
REDIS_PREFIX_RATELIMIT=medikiosk:rl:
REDIS_PREFIX_IDEMPOTENCY=medikiosk:idem:

# Interview/session TTL (seconds). Bound so abandoned kiosks do not leak PII in Redis.
INTERVIEW_STATE_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=86400
LOCK_TTL_SECONDS=15

# --- JWT auth (SECRET) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_URLSAFE
JWT_REFRESH_SECRET_KEY=CHANGE_ME_GENERATE_DIFFERENT_64_CHAR
JWT_ALGORITHM=HS256
# Short-lived access tokens (minutes)
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=medikiosk

# --- Field-level encryption for Aadhaar/ABHA/PII (SECRET) ---
# 32-byte key, urlsafe-base64. Generate:
# python -c "from cryptography.hazmat.primitives.kdf.hkdf import HKDF; import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_URLSAFE_BASE64
# Separate HMAC key so ciphertext stealers cannot brute-force lookups without this
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PII_LOOKUP_HMAC_KEY=CHANGE_ME_32_BYTE_URLSAFE_BASE64
# Key id for rotation; ciphertext is prefixed with this id
FIELD_ENCRYPTION_KEY_ID=v1

# --- Rate limiting ---
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- CORS / kiosk origins (set real clinic domains in production) ---
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---
UPLOAD_TEMP_DIR=/app/uploads/temp_scans
UPLOAD_VAULT_DIR=/app/uploads/encrypted_vault
TEMP_SCAN_TTL_SECONDS=3600

# --- External integrations (SECRET). Empty = mock in development, fail in production. ---
BHASHINI_API_KEY=
BHASHINI_BASE_URL=https://bhashini.gov.in/api
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_WEBHOOK_SECRET=
OCR_VENDOR_API_KEY=
OCR_VENDOR_BASE_URL=

# --- Celery (used from Phase 7; declared now so workers share the same config) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
