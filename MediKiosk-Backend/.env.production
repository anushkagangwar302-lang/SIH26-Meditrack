# MediKiosk-Backend Production Environment Configuration
# ============================================================================
# WARNING: This file contains SENSITIVE SECRETS for production
# - NEVER commit .env.production to version control
# - Use secure secret management (Vault, AWS Secrets Manager, Docker Secrets)
# - Rotate secrets regularly (every 90 days minimum)
# - Audit access to this file
# ============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=production
APP_ENV=production
DEBUG=false
APP_NAME=MediKiosk-Backend
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# IMPORTANT: Update with your production database credentials
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://medikiosk:YOUR_SECURE_DB_PASSWORD@prod-db-host:5432/medikiosk
POSTGRES_PASSWORD=YOUR_SECURE_DB_PASSWORD

# Connection pool settings (adjust based on replica count)
# For 3 API replicas with Postgres max_connections=100:
# pool_size = (100 / 3) - 10 = ~20 per replica
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Production: Use managed Redis (AWS ElastiCache, Redis Cloud) with auth
REDIS_HOST=prod-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD

# Redis database allocation (do NOT change)
REDIS_DB_SESSION=0
REDIS_DB_LOCKS=1
REDIS_DB_RATELIMIT=2
REDIS_DB_CACHE=3
REDIS_DB_CELERY_BROKER=4
REDIS_DB_CELERY_RESULT=5

# Redis connection pool
REDIS_POOL_SIZE=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# SECURITY & ENCRYPTION (DPDP Act 2023 Compliance)
# =============================================================================
# JWT Access Token Secret (minimum 64 characters, cryptographically random)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=YOUR_PRODUCTION_JWT_SECRET_KEY_HERE_MIN_64_CHARS_GENERATED_SECURELY

# JWT Refresh Token Secret (MUST differ from access token secret)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_REFRESH_SECRET_KEY=YOUR_PRODUCTION_JWT_REFRESH_SECRET_KEY_HERE_MIN_64_CHARS_UNIQUE

# JWT Token Expiration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Field-Level Encryption Key (32 bytes, base64 encoded)
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# This key encrypts PII fields (Aadhaar, ABHA) at database level
FIELD_ENCRYPTION_KEY=YOUR_PRODUCTION_FIELD_ENCRYPTION_KEY_32BYTES_BASE64_ENCODED

# HMAC Key for Webhook Signature Verification (32 bytes, base64 encoded)
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Used for ABDM webhook payload verification
WEBHOOK_HMAC_KEY=YOUR_PRODUCTION_WEBHOOK_HMAC_KEY_32BYTES_BASE64_ENCODED

# Password hashing algorithm
PASSWORD_HASH_ALGORITHM=argon2id

# =============================================================================
# ABDM / ABHA INTEGRATION
# =============================================================================
# ABDM Health Information Exchange - Consent Manager
# Production URL: https://hie-cm.abdm.gov.in
ABDM_HIE_CM_BASE_URL=https://hie-cm.abdm.gov.in

# ABDM Credentials (obtain from https://abdm.gov.in/)
ABDM_CLIENT_ID=YOUR_PRODUCTION_ABDM_CLIENT_ID
ABDM_CLIENT_SECRET=YOUR_PRODUCTION_ABDM_CLIENT_SECRET

# ABDM Callback URL (must be publicly accessible HTTPS endpoint)
ABDM_CALLBACK_URL=https://your-production-domain.com/api/v1/abdm/webhooks

# DEVELOPMENT ONLY: Mock ABHA OTP for testing
# MUST BE EMPTY/UNSET IN PRODUCTION
DEV_ABHA_OTP=

# =============================================================================
# BHASHINI / AI4BHARAT VOICE INTEGRATION
# =============================================================================
# Production Bhashini API endpoint
BHASHINI_API_URL=https://api.bhashini.gov.in

# Bhashini Credentials (obtain from https://bhashini.gov.in/)
BHASHINI_API_KEY=YOUR_PRODUCTION_BHASHINI_API_KEY
BHASHINI_USER_ID=YOUR_PRODUCTION_BHASHINI_USER_ID

# Bhashini Pipeline IDs (language-specific, configure per deployment)
BHASHINI_ASR_PIPELINE_ID=YOUR_PRODUCTION_ASR_PIPELINE_ID
BHASHINI_TTS_PIPELINE_ID=YOUR_PRODUCTION_TTS_PIPELINE_ID

# Fallback language when Bhashini unavailable
BHASHINI_FALLBACK_LANGUAGE=en

# =============================================================================
# OCR / DOCUMENT PROCESSING
# =============================================================================
# OCR Provider: tesseract (local), google_vision, aws_textract, azure_form_recognizer
OCR_SERVICE_PROVIDER=tesseract

# API key for cloud OCR providers (if applicable)
OCR_API_KEY=YOUR_PRODUCTION_OCR_API_KEY

# OCR service endpoint (if using self-hosted OCR)
OCR_SERVICE_URL=http://ocr-service:8080

# OCR processing timeout (seconds)
OCR_TIMEOUT=30

# =============================================================================
# CELERY BACKGROUND JOBS CONFIGURATION
# =============================================================================
# Celery Broker (Redis)
CELERY_BROKER_URL=redis://:YOUR_SECURE_REDIS_PASSWORD@prod-redis-host:6379/4

# Celery Result Backend (Redis)
CELERY_RESULT_BACKEND=redis://:YOUR_SECURE_REDIS_PASSWORD@prod-redis-host:6379/5

# Task serialization format (JSON recommended for security)
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# Timezone for scheduled tasks
CELERY_TIMEZONE=Asia/Kolkata

# Task timeout settings (seconds)
CELERY_TASK_TIMEOUT=300
CELERY_TASK_SOFT_TIMEOUT=240

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limit for general API endpoints (requests per minute per IP)
RATE_LIMIT_GENERAL=600

# Rate limit for authentication endpoints (requests per minute per IP)
RATE_LIMIT_AUTH=300

# Rate limit for document upload (requests per minute per IP)
RATE_LIMIT_UPLOAD=600

# Rate limit for WebSocket connections (connections per minute per IP)
RATE_LIMIT_WEBSOCKET=300

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Maximum file upload size (MB)
MAX_UPLOAD_SIZE_MB=50

# Allowed file types for document uploads
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# Temporary scan file retention (hours)
TEMP_SCAN_RETENTION_HOURS=24

# Encrypted vault retention (days)
ENCRYPTED_VAULT_RETENTION_DAYS=365

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (production), text (development)
LOG_FORMAT=json

# Request ID header for distributed tracing
REQUEST_ID_HEADER=X-Request-ID

# Audit log file path (compliance tracking)
AUDIT_LOG_PATH=/var/log/medikiosk/audit.log

# =============================================================================
# CORS & FRONTEND CONFIGURATION
# =============================================================================
# CORS allowed origins (comma-separated)
# IMPORTANT: Set to your production frontend domain only
CORS_ORIGINS=https://your-production-frontend-domain.com

# Trusted proxy count (for X-Forwarded-For header)
TRUSTED_PROXY_COUNT=1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# AYUSH clinical intake system
FEATURE_AYUSH_ENABLED=true

# SOCRATES dialogue branching logic
FEATURE_SOCRATES_ENABLED=true

# ABDM integration (set false if ABDM unavailable)
FEATURE_ABDM_ENABLED=true

# Bhashini voice interface
FEATURE_VOICE_ENABLED=true

# OCR document processing
FEATURE_OCR_ENABLED=true

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
# Enable Prometheus metrics endpoint
METRICS_ENABLED=true

# Metrics endpoint path
METRICS_PATH=/metrics

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# DPDP ACT 2023 COMPLIANCE
# =============================================================================
# DPDP Notice version shown to users
DPDP_NOTICE_VERSION=dpdp-notice-2026-01

# =============================================================================
# SECURITY: DEVELOPMENT FLAGS (MUST BE FALSE IN PRODUCTION)
# =============================================================================
# Debug mode - NEVER set to true in production
DEBUG=false

# Auto-reload - NEVER enable in production
AUTO_RELOAD=false

# Mock external services - MUST be false in production
MOCK_EXTERNAL_SERVICES=false

# Skip SSL verification - MUST be false in production
SKIP_SSL_VERIFICATION=false
